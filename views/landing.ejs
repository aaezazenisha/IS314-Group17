<%- include('partials/header', { title: 'JAATCampusStay | Hostel Room Booking System', user }) %>
<section class="auth-layout">
  <div class="auth-intro">
    <div class="intro-inner">
      <div class="eyebrow eyebrow-light">University accommodation portal</div>
      <div class="intro-brand"><span class="brand-mark brand-mark-large">JC</span><span>JAATCampusStay</span></div>
      <h1>Find your place.<br><em>Feel at home.</em></h1>
      <p>Access and manage your university hostel accommodation through one secure system.</p>
      <div class="feature-list">
        <div><span class="feature-icon">⌂</span><span><strong>Live room availability</strong><small>See accommodation options as they become available.</small></span></div>
