<%- include('partials/header', { title: 'Admin login | JAATCampusStay', user }) %>
<section class="auth-layout auth-layout-simple">
  <div class="auth-intro"><div class="intro-inner"><div class="intro-brand"><span class="brand-mark brand-mark-large">JC</span><span>JAATCampusStay</span></div><div class="eyebrow eyebrow-light">Administration</div><h1>Manage with<br><em>confidence.</em></h1><p>The administration portal is prepared for the Admin Dashboard and Reports module.</p></div></div>
  <div class="auth-panel"><div class="login-card card"><div class="login-heading"><div class="eyebrow">Administration</div><h2>Admin login</h2><p>Sign in to continue to the administration portal.</p></div><div class="login-options"><a class="login-option" href="/login"><span>Student login</span><small>For residents</small></a><a class="login-option selected" href="/admin/login"><span>Admin login</span><small>For administrators</small></a></div><% if (error) { %><div class="alert error" role="alert"><%= error %></div><% } %><form action="/admin/login" method="post"><div class="form-field"><label for="identifier">Admin username or email</label><input id="identifier" name="identifier" required autocomplete="username"></div><div class="form-field password-field"><label for="password">Password</label><input id="password" name="password" type="password" required autocomplete="current-password"></div><div class="form-row"><label class="checkbox-label"><input type="checkbox" name="remember"> Remember me</label><span class="muted-link">Forgot password?</span></div><button class="button button-wide" type="submit">Admin sign in</button></form><p class="login-note">Administrator accounts are managed separately. There is no public admin registration.</p></div></div>
</section>
